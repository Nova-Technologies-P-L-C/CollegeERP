# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
frontend/node_modules/
backend/vendor/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
frontend/.next/
out/
frontend/out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
frontend/.env*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

/src/generated/prisma
frontend/src/generated/prisma
.github/skills/

# clerk configuration (can include secrets)
.clerk/
frontend/.clerk/

# laravel backend
backend/database/*.sqlite
backend/storage/*.key
backend/storage/logs/*.log
backend/bootstrap/cache/*.php

# editor temp / swap files
*.save
*.save.*
*~
*.bak
